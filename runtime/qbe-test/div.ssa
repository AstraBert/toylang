# Covers: tl_div
# Expected output:
# 3.5
# 2.0
# 0.25
# 0.3333333333333333
export function w $main() {
@start
    %a1 =d copy d_7.0
    %b1 =d copy d_2.0
    %r1 =d call $tl_div(d %a1, d %b1)
    call $tl_print_float(d %r1)

    %a2 =d copy d_8.0
    %b2 =d copy d_4.0
    %r2 =d call $tl_div(d %a2, d %b2)
    call $tl_print_float(d %r2)

    %a3 =d copy d_1.0
    %b3 =d copy d_4.0
    %r3 =d call $tl_div(d %a3, d %b3)
    call $tl_print_float(d %r3)

    %a4 =d copy d_1.0
    %b4 =d copy d_3.0
    %r4 =d call $tl_div(d %a4, d %b4)
    call $tl_print_float(d %r4)
    ret 0
}
