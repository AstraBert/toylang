# Covers: tl_pow_float with zero to a negative power (0.0 ** -1.0)
# Expected: prints 99, then an error message on stderr, exit code 1 (check with: echo $?)
# 100 must NEVER be printed.
export function w $main() {
@start
    %t1 =l copy 99
    call $tl_print_int(l %t1)
    %a =d copy d_0.0
    %p =d copy d_1.0
    %b =d neg %p
    %r =d call $tl_pow_float(d %a, d %b)
    call $tl_print_float(d %r)
    %t2 =l copy 100
    call $tl_print_int(l %t2)
    ret 0
}
